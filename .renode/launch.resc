mach create "trq"

machine LoadPlatformDescription @platforms/boards/stm32f4_discovery-kit.repl

sysbus LoadELF @build/Debug/HL7_Parser.elf

sysbus.cpu VectorTableOffset 0x08000000

emulation CreateUartPtyTerminal "usart2Pty" "/tmp/trq-usart2" true
connector Connect sysbus.usart2 usart2Pty

emulation CreateUartPtyTerminal "uart4Pty" "/tmp/trq-uart4" true
connector Connect sysbus.uart4 uart4Pty

showAnalyzer sysbus.usart2
showAnalyzer sysbus.uart4

machine StartGdbServer 3333